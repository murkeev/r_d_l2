              "pm.test(\"Has joke fields\", () => {\r",
              "    const joke = pm.response.json();    \r",
              "\r",
              "    pm.collectionVariables.set(\"jokeId\", joke.id);\r",
              "    pm.collectionVariables.set(\"jokeType\", joke.type);\r",
              "        \r",
              "    pm.expect(joke).to.have.all.keys('id', 'type', 'setup', 'punchline');\r",
              "}); \r",
              "\r",
              "pm.test(\"id is a number\", () => {\r",
              "    const joke = pm.response.json();\r",
              "    pm.expect(joke.id).to.be.a('number');\r",
